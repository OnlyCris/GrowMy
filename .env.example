# ============================================================================
# GrowMy — variabili d'ambiente
#
# Copia questo file in `.env` e compila i valori.
#   cp .env.example .env && chmod 600 .env
#
# `scripts/install.sh` genera automaticamente i segreti marcati [auto].
# Tutti gli altri richiedono un valore preso dal rispettivo provider.
#
# REGOLA: nessun valore reale entra mai in questo file. Se stai per incollare
# una chiave qui dentro, stai commettendo l'errore che questo file esiste per
# prevenire.
#
# Il build fallisce se manca una variabile critica (t3-env, packages/env).
# È voluto: meglio un deploy che non parte di uno che parte rotto.
# ============================================================================

# ----------------------------------------------------------------------------
# Applicazione
# ----------------------------------------------------------------------------
NODE_ENV=production

# URL pubblico completo, senza slash finale. Usato per i redirect OAuth e i
# link nelle email: se è sbagliato, il login rimanda al dominio sbagliato.
NEXT_PUBLIC_APP_URL=https://growmy.example.com

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Tag dell'immagine Docker. `update.sh` lo valorizza con lo SHA del commit,
# che è ciò che rende possibile il rollback a una versione precisa.
IMAGE_TAG=latest

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# [auto] Password del ruolo app_user (RLS attivo).
POSTGRES_PASSWORD=

# [auto] Password del ruolo app_worker (BYPASSRLS).
# Se lasciata vuota viene riusata POSTGRES_PASSWORD. In produzione è meglio
# separarle: rende revocabile l'accesso del worker senza toccare l'app.
POSTGRES_WORKER_PASSWORD=

# [auto] Password del ruolo app_migrator (solo DDL, solo in deploy).
POSTGRES_MIGRATOR_PASSWORD=

# Dimensione massima del pool per processo.
DATABASE_POOL_MAX=10

# TLS verso il database.
#   false -> Postgres nel container su rete Docker isolata (il nostro deploy).
#            Il traffico non lascia mai l'host e il server non offre TLS.
#   true  -> database gestito remoto (Supabase, RDS, Neon).
DATABASE_SSL=false

# ----------------------------------------------------------------------------
# Supabase (autenticazione)
# ----------------------------------------------------------------------------
# Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chiave anonima. È pubblica per costruzione: finisce nel bundle del browser.
# La sicurezza non dipende dal tenerla segreta ma dalle policy RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave service role. BYPASSA RLS COMPLETAMENTE.
# Non deve MAI comparire in codice client né in un log. Trattala come una
# password di root del database.
SUPABASE_SERVICE_ROLE_KEY=

# Segreto JWT del progetto. Serve a verificare i token lato server.
SUPABASE_JWT_SECRET=

# ----------------------------------------------------------------------------
# Cifratura delle credenziali CMS
# ----------------------------------------------------------------------------
# [auto] Chiave AES-256-GCM in base64, esattamente 32 byte decodificati.
#   openssl rand -base64 32
#
# Cifra i token di WordPress, Webflow, Shopify e degli altri CMS dei clienti.
# È presente SOLO nell'ambiente del worker: l'app web non deve poter decifrare
# le credenziali dei siti dei clienti.
#
# ATTENZIONE: perdere questa chiave rende irrecuperabili tutte le integrazioni.
# Conservala in un password manager, non solo su questo server.
CREDENTIALS_ENCRYPTION_KEY=

# Incrementa quando ruoti la chiave. Consente la rotazione senza downtime:
# le righe cifrate con la versione precedente restano decifrabili.
CREDENTIALS_KEY_VERSION=1

# ----------------------------------------------------------------------------
# Provider LLM — basta UNA di queste tre chiavi
# ----------------------------------------------------------------------------
# GOOGLE (Gemini) — https://aistudio.google.com/apikey
# La via più economica per iniziare: ha un piano gratuito generoso.
#
# NON confonderla con GOOGLE_CLIENT_ID/SECRET più sotto: quelli servono per il
# login e Search Console, questa serve a generare testo. Console diverse,
# chiavi diverse, non intercambiabili.
#
# Più chiavi separate da virgola: ogni chiave ha un bucket di quota
# indipendente sul piano gratuito, il router ruota fra tutte per non saturarne
# una sola. Una sola chiave resta valida.
GOOGLE_GENERATIVE_AI_API_KEY=
# Più modelli separati da virgola, stesso motivo: modelli diversi con la
# STESSA chiave hanno bucket di quota indipendenti. Default: gemini-flash-latest.
GOOGLE_GENERATIVE_AI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# DEEPSEEK — https://platform.deepseek.com -> API Keys
# Molto economico, API compatibile con OpenAI. La chiave inizia con "sk-".
DEEPSEEK_API_KEY=
# Endpoint. Da cambiare solo per un proxy o un self-host.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ANTHROPIC (Claude) — https://console.anthropic.com -> API Keys
# Qualità di scrittura più alta sui testi lunghi, costo maggiore.
ANTHROPIC_API_KEY=

# OPENAI — https://platform.openai.com -> API Keys (opzionale)
OPENAI_API_KEY=

# OPENROUTER — https://openrouter.ai/keys
# Un solo endpoint OpenAI-compatibile davanti a decine di modelli di provider
# diversi: comodo come fallback quando un provider diretto esaurisce quota o
# credito, senza dover cambiare integrazione.
OPENROUTER_API_KEY=
# Slug "provider/nome" del modello da usare. Default: openai/gpt-4o-mini.
OPENROUTER_MODEL=

# Ordine di fallback. Se il primo provider è in errore, rate-limited o senza
# chiave, il router passa al successivo invece di far fallire il job.
# Valori ammessi: google, deepseek, anthropic, openai, openrouter
LLM_PROVIDER_ORDER=openrouter,google,deepseek,anthropic

# ----------------------------------------------------------------------------
# Stripe
# ----------------------------------------------------------------------------
# dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=

# dashboard.stripe.com -> Developers -> Webhooks -> Signing secret
# Verifica la firma dei webhook. Senza, chiunque potrebbe simulare un pagamento
# riuscito e accreditarsi crediti.
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Google OAuth (login "Accedi con Google" + Search Console)
# ----------------------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#
# DUE redirect URI autorizzati, entrambi obbligatori. Google confronta la
# stringa ESATTA (barra finale inclusa): un disallineamento di un carattere
# produce `redirect_uri_mismatch` e nient'altro.
#   ${NEXT_PUBLIC_APP_URL}/auth/callback              login utenti
#   ${NEXT_PUBLIC_APP_URL}/api/oauth/gsc/callback     Search Console
#
# Per Search Console serve anche abilitare l'API sul progetto:
#   APIs & Services -> Library -> "Google Search Console API" -> Enable
# Senza, il consenso riesce e ogni query successiva torna 403 — un errore che
# sembra un problema di permessi dell'utente e non lo è.
#
# DIVERSO da GOOGLE_GENERATIVE_AI_API_KEY: questo autorizza gli utenti, quella
# genera testo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Sicurezza applicativa
# ----------------------------------------------------------------------------
# [auto] Firma dei token double-submit anti-CSRF.  openssl rand -hex 32
CSRF_SECRET=

# [auto] HMAC dei webhook in uscita.               openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=

# ----------------------------------------------------------------------------
# Worker
# ----------------------------------------------------------------------------
# Job concorrenti per processo. Alzarlo aumenta il throughput ma anche il
# consumo di memoria e la pressione sui rate limit dei provider LLM.
# Su una VPS da 4 GB, 3 è un valore sensato.
WORKER_CONCURRENCY=3

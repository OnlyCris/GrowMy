# ============================================================================
# GrowMy — ambiente di SVILUPPO LOCALE
#
#   cp .env.local.example .env.local
#
# Con questi valori l'app parte senza Supabase, senza Stripe e senza dominio.
# L'unica cosa che devi procurarti è la chiave Gemini, e solo quando vorrai
# generare articoli veri.
#
# NON usare questo file in produzione: per quello c'è .env.example.
# ============================================================================

NODE_ENV=development

# ----------------------------------------------------------------------------
# Autenticazione locale
# ----------------------------------------------------------------------------
# Salta Supabase e considera autenticato l'utente creato dal seed.
#
# Funziona SOLO in sviluppo: il modulo che lo implementa lancia un errore
# fatale se importato con NODE_ENV=production. Non è una convenzione, è una
# barriera — il processo non parte proprio.
#
# Metti 'false' quando vorrai provare il login Google vero.
DEV_AUTH_BYPASS=true

# ----------------------------------------------------------------------------
# Infrastruttura locale (docker/docker-compose.dev.yml)
# ----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/growmy
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/growmy
REDIS_URL=redis://localhost:6379/0
DATABASE_POOL_MAX=5

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Supabase — segnaposto
# ----------------------------------------------------------------------------
# Con DEV_AUTH_BYPASS=true questi valori non vengono mai usati, ma devono
# esistere ed essere formalmente validi: t3-env valida all'avvio e un URL
# malformato blocca il boot.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=local-service-role-placeholder
SUPABASE_JWT_SECRET=local-jwt-secret-placeholder-min-32-characters-long

# ----------------------------------------------------------------------------
# Provider LLM
# ----------------------------------------------------------------------------
# Necessaria solo per generare articoli veri. Per navigare la coda di revisione
# con i dati del seed basta il segnaposto: non viene mai chiamata.
#   https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyPlaceholderPlaceholderPlaceholder
LLM_PROVIDER_ORDER=google

# ----------------------------------------------------------------------------
# Segreti di sviluppo
# ----------------------------------------------------------------------------
# Valori fissi e volutamente NON segreti: servono solo a superare la validazione.
# In produzione install.sh ne genera di reali con openssl.
CSRF_SECRET=dev-csrf-secret-not-secret-at-all-32chars
WEBHOOK_SIGNING_SECRET=dev-webhook-secret-not-secret-at-all-32c

# Deve decodificare a ESATTAMENTE 32 byte (AES-256). Questo vale
# 'dev-key-not-secret-32-bytes-ok!!'. Per generarne uno vero:
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=ZGV2LWtleS1ub3Qtc2VjcmV0LTMyLWJ5dGVzLW9rISE=
CREDENTIALS_KEY_VERSION=1

# ----------------------------------------------------------------------------
# Servizi esterni — segnaposto
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-placeholder

# ----------------------------------------------------------------------------
# Log
# ----------------------------------------------------------------------------
# 'debug' mostra anche l'SQL generato da Drizzle: comodo per accorgersi di un
# N+1 mentre lo stai scrivendo.
LOG_LEVEL=debug

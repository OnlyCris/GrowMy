{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": true,
    // I pacchetti workspace sono TypeScript sorgente: `tsc` deve poterli
    // risolvere e includere nell'output compilato.
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
